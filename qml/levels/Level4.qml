import QtQml 2.15

// Учебный уровень для самостоятельного редактирования.
// Каждый символ строки — одна клетка; строки расположены сверху вниз.
//
// Легенда:
//   # — кирпич, . — пусто, P — старт Персонажа, X — портал,
//   x — безопасная клетка перед порталом, C — Кристалл, $ — Приз,
//   K — Ключ, который нужно отнести к Сейфу B на втором экране.
//
// Все C и $ в начале уровня стоят над кирпичной опорой.
// В нижнем коридоре Приз в (row 11, column 8) закрыт кирпичом в column 7;
// кирпич справа в column 9 не даёт обойти награду. Встаньте в (row 10,
// column 6), повернитесь вправо и нажмите Space.
// Проходы около шахт и короткие перемычки позволяют обойти платформы.
QtObject {
    readonly property var rows: [
        "####################", // row 0: потолок
        "#..$....#....$.....#", // row 1: два Приза на опорах row 2
        "#..###..#..###.....#", // row 2: верхняя платформа и проходы
        "#..C...#...C.......#", // row 3: Кристаллы над кирпичами row 4
        "#..###.#...#.###...#", // row 4: опоры и боковые простенки
        "#..$....#...$......#", // row 5: Призы над опорами row 6
        "#..#####....#####..#", // row 6: вторая платформа
        "#.....C....C.......#", // row 7: Кристаллы над row 8
        "#..####....####....#", // row 8: опоры; центральные проходы открыты
        "#...$.......$......#", // row 9: нижние Призы над row 10
        "#...##..##..#..K...#", // row 10: клетка подхода c6 и Ключ на c15
        "#XxP...#$#.......xX#", // row 11: старт, карман с Призом и оба портала
        "####################"  // row 12: пол
    ]
}
